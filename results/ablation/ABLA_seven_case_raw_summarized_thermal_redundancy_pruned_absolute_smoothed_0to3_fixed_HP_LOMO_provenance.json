{
  "purpose": "Seven-case controlled comparison of raw, summarized, thermal-only, and redundancy-pruned representations",
  "temperature_folders": [
    "30C",
    "40C",
    "50C",
    "60C"
  ],
  "target": "eff",
  "analysis_window": [
    0.0,
    3.0
  ],
  "input_preprocessing": {
    "sensor_values": "absolute processed-file Primary and Secondary values",
    "smoothing": "Savitzky-Golay applied equally to every branch",
    "baseline_centering": false,
    "minmax_normalization": false,
    "standard_scaler": false,
    "esn_channels": [
      "Primary",
      "Secondary",
      "Primary-Secondary",
      "dPrimary/dt",
      "dSecondary/dt"
    ]
  },
  "raw_state_representation": {
    "time_points": 31,
    "time_grid_seconds": [
      0.0,
      0.1,
      0.2,
      0.30000000000000004,
      0.4,
      0.5,
      0.6000000000000001,
      0.7000000000000001,
      0.8,
      0.9,
      1.0,
      1.1,
      1.2000000000000002,
      1.3,
      1.4000000000000001,
      1.5,
      1.6,
      1.7000000000000002,
      1.8,
      1.9000000000000001,
      2.0,
      2.1,
      2.2,
      2.3000000000000003,
      2.4000000000000004,
      2.5,
      2.6,
      2.7,
      2.8000000000000003,
      2.9000000000000004,
      3.0
    ],
    "flatten_order": "time-major"
  },
  "summaries_per_unit": [
    "mean",
    "std",
    "min",
    "max",
    "initial",
    "net_change",
    "slope",
    "mean_abs",
    "abs_auc"
  ],
  "scalar_thermal_features": [
    "thermal_primary_final_change",
    "thermal_primary_max_abs_change",
    "thermal_primary_response_auc",
    "thermal_primary_max_abs_rate",
    "thermal_primary_rate_auc",
    "thermal_primary_early_slope",
    "thermal_primary_middle_slope",
    "thermal_primary_late_slope",
    "thermal_secondary_final_change",
    "thermal_secondary_max_abs_change",
    "thermal_secondary_response_auc",
    "thermal_secondary_max_abs_rate",
    "thermal_secondary_rate_auc",
    "thermal_secondary_early_slope",
    "thermal_secondary_middle_slope",
    "thermal_secondary_late_slope",
    "thermal_difference_final_change",
    "thermal_difference_max_abs_change",
    "thermal_difference_response_auc",
    "thermal_difference_max_abs_rate",
    "thermal_difference_rate_auc",
    "thermal_difference_early_slope",
    "thermal_difference_middle_slope",
    "thermal_difference_late_slope",
    "thermal_secondary_primary_auc_ratio",
    "thermal_initial_sensor_difference",
    "thermal_final_sensor_difference"
  ],
  "temperature_used_as_regressor_feature": false,
  "conditions": {
    "A_raw_ESN_states": {
      "esn_representation": "raw",
      "include_thermal": false,
      "optimize_features": false
    },
    "B_summarized_ESN_states": {
      "esn_representation": "summarized",
      "include_thermal": false,
      "optimize_features": false
    },
    "C_raw_ESN_plus_thermal": {
      "esn_representation": "raw",
      "include_thermal": true,
      "optimize_features": false
    },
    "D_summarized_ESN_plus_thermal": {
      "esn_representation": "summarized",
      "include_thermal": true,
      "optimize_features": false
    },
    "E_thermal_features_only": {
      "esn_representation": "none",
      "include_thermal": true,
      "optimize_features": false
    },
    "F_optimized_summarized_ESN": {
      "esn_representation": "summarized",
      "include_thermal": false,
      "optimize_features": true
    },
    "G_optimized_summarized_ESN_plus_thermal": {
      "esn_representation": "summarized",
      "include_thermal": true,
      "optimize_features": true
    }
  },
  "feature_pruning": {
    "applied_conditions": [
      "F_optimized_summarized_ESN",
      "G_optimized_summarized_ESN_plus_thermal"
    ],
    "scope": "refitted independently inside each outer LOMO training fold and reservoir seed",
    "near_constant_relative_tolerance": 1e-12,
    "ranking": "absolute Spearman correlation with log1p training target",
    "redundancy_measure": "absolute pairwise Spearman correlation among training predictors",
    "redundancy_threshold": 0.95,
    "held_out_material_used_for_selection": false
  },
  "esn_parameters": {
    "res_size": 20,
    "leak_rate": 0.3,
    "input_magnitude": 1.0,
    "spectral_radius": 0.9,
    "washout": 0
  },
  "xgb_parameters": {
    "n_estimators": 300,
    "max_depth": 3,
    "learning_rate": 0.05,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "min_child_weight": 5,
    "reg_alpha": 0.1,
    "reg_lambda": 10.0
  },
  "reservoir_seeds": [
    42,
    43,
    44
  ],
  "validation": "14-fold leave-one-material-out; metrics pooled over 336 OOF trial predictions per condition",
  "fairness_note": "No condition-specific ESN or XGBoost hyperparameter optimization was performed."
}